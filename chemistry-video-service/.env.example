# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional API key. When set, /v1 routes require the X-API-Key header.
# API_KEY=change-me
# Optional fixed-window rate limit per client IP. 0 disables the limiter.
RATE_LIMIT_PER_MINUTE=0
MAX_REQUEST_BYTES=65536

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
ARTIFACT_DIR=./artifacts
DATA_DIR=./data
ASSETS_DIR=./assets
# NARRATION_CACHE_DIR=./data/narration_cache

JOB_REPOSITORY=memory
# JOB_REPOSITORY=sqlite
DATABASE_URL=sqlite:///./data/app.db

# ---------------------------------------------------------------------------
# Video
# ---------------------------------------------------------------------------
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
VIDEO_QUALITY=high
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=900

# low | medium | high
# VIDEO_QUALITY=medium

# ---------------------------------------------------------------------------
# Scripts
# ---------------------------------------------------------------------------
SCRIPT_SOURCE=canonical
# SCRIPT_SOURCE=canonical_with_llm_fallback

# Only used when SCRIPT_SOURCE=canonical_with_llm_fallback.
# LLM_PROVIDER=none | mock | openai_compatible
LLM_PROVIDER=none
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# ---------------------------------------------------------------------------
# Narration
# ---------------------------------------------------------------------------
TTS_PROVIDER=canonical_cache
# TTS_PROVIDER=espeak
# TTS_PROVIDER=windows_sapi
# TTS_PROVIDER=openai
# TTS_PROVIDER=mock

# Empty means the provider default voice.
TTS_VOICE=
# SAPI rate is -10..10; espeak rate is words per minute (see TTS_ESPEAK_WPM).
TTS_RATE=-1
TTS_ESPEAK_WPM=150

# OPENAI_API_KEY=
# OPENAI_TTS_BASE_URL=https://api.openai.com/v1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

ALLOW_PLACEHOLDER_AUDIO=false
ENABLE_IDEMPOTENCY=true

# ---------------------------------------------------------------------------
# Worker / generation
# ---------------------------------------------------------------------------
# real | fake (fake is only for tests and local integration work)
GENERATION_MODE=real
# Delay between fake-pipeline stages (integration tests only).
FAKE_STEP_DELAY_SECONDS=0.02
# embedded | api_only | standalone
WORKER_MODE=embedded
WORKER_POLL_INTERVAL_SECONDS=1.0
KEEP_WORK_DIR=false
CALLBACK_TIMEOUT_SECONDS=5.0
PIPELINE_VERSION=1.0.0

# ---------------------------------------------------------------------------
# FFmpeg
# ---------------------------------------------------------------------------
# The service also auto-discovers winget / common install locations when these
# names are not on PATH.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_THREADS=0
FFMPEG_TIMEOUT_SECONDS=300
